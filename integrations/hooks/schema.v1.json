{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://hookr.fun/schemas/external-hook.v1.json",
  "title": "Hookr external hook integration manifest",
  "description": "Portable source, compatibility, security, deployment, and Uniswap-listing evidence for a third-party Uniswap v4 hook.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "slug",
    "name",
    "summary",
    "status",
    "integrationMode",
    "author",
    "source",
    "integration",
    "uniswapClassification",
    "security",
    "deployments"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": "hookr.external-hook.v1"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 80
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "status": {
      "enum": [
        "source-only",
        "testnet-verified",
        "production-verified",
        "listing-submitted",
        "listed"
      ]
    },
    "integrationMode": {
      "enum": ["composable-blueprint", "standalone-hook-product"]
    },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": ["github"],
      "properties": {
        "github": {
          "type": "string",
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$"
        },
        "website": {
          "$ref": "#/definitions/httpsUrl"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "pinnedCommit",
        "license",
        "hookContract",
        "contracts"
      ],
      "properties": {
        "repository": {
          "$ref": "#/definitions/httpsUrl"
        },
        "pinnedCommit": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{40}$"
        },
        "license": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "hookContract": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "contracts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        }
      }
    },
    "integration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "poolScope",
        "supportedTracks",
        "standardSwapBehavior",
        "dedicatedRouter",
        "dependencies"
      ],
      "properties": {
        "poolScope": {
          "enum": ["canonical-pool-only", "multi-pool", "per-pool-instance"]
        },
        "supportedTracks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "hook_publication",
              "hook_token_launch",
              "existing_token_pool",
              "launchpad_sdk",
              "hook_generator",
              "executor_adapter"
            ]
          }
        },
        "standardSwapBehavior": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "dedicatedRouter": {
          "type": "object",
          "additionalProperties": false,
          "required": ["requiredForAllSwaps", "contract", "purpose"],
          "properties": {
            "requiredForAllSwaps": {
              "type": "boolean"
            },
            "contract": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            "purpose": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "kind", "required"],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "kind": {
                "enum": [
                  "protocol",
                  "oracle",
                  "token",
                  "router",
                  "factory",
                  "locker",
                  "other"
                ]
              },
              "required": {
                "type": "boolean"
              },
              "notes": {
                "type": "string",
                "maxLength": 500
              }
            }
          }
        }
      }
    },
    "uniswapClassification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["flags", "properties"],
      "properties": {
        "flags": {
          "$ref": "#/definitions/hookFlags"
        },
        "properties": {
          "$ref": "#/definitions/hookProperties"
        }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "auditStatus",
        "auditUrls",
        "authorityModel",
        "immutableDependencies",
        "knownRisks"
      ],
      "properties": {
        "auditStatus": {
          "enum": ["unaudited", "reviewed", "audited"]
        },
        "auditUrls": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/httpsUrl"
          }
        },
        "authorityModel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "immutableDependencies": {
          "type": "boolean"
        },
        "knownRisks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      }
    },
    "deployments": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/deployment"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "source-only"
          }
        }
      },
      "then": {
        "properties": {
          "deployments": {
            "type": "array",
            "maxItems": 0
          }
        }
      },
      "else": {
        "properties": {
          "deployments": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    }
  ],
  "definitions": {
    "address": {
      "type": "string",
      "pattern": "^0x[a-fA-F0-9]{40}$"
    },
    "bytes32": {
      "type": "string",
      "pattern": "^0x[a-fA-F0-9]{64}$"
    },
    "httpsUrl": {
      "type": "string",
      "pattern": "^https://"
    },
    "hookFlags": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "beforeInitialize",
        "afterInitialize",
        "beforeAddLiquidity",
        "afterAddLiquidity",
        "beforeRemoveLiquidity",
        "afterRemoveLiquidity",
        "beforeSwap",
        "afterSwap",
        "beforeDonate",
        "afterDonate",
        "beforeSwapReturnsDelta",
        "afterSwapReturnsDelta",
        "afterAddLiquidityReturnsDelta",
        "afterRemoveLiquidityReturnsDelta"
      ],
      "properties": {
        "beforeInitialize": { "type": "boolean" },
        "afterInitialize": { "type": "boolean" },
        "beforeAddLiquidity": { "type": "boolean" },
        "afterAddLiquidity": { "type": "boolean" },
        "beforeRemoveLiquidity": { "type": "boolean" },
        "afterRemoveLiquidity": { "type": "boolean" },
        "beforeSwap": { "type": "boolean" },
        "afterSwap": { "type": "boolean" },
        "beforeDonate": { "type": "boolean" },
        "afterDonate": { "type": "boolean" },
        "beforeSwapReturnsDelta": { "type": "boolean" },
        "afterSwapReturnsDelta": { "type": "boolean" },
        "afterAddLiquidityReturnsDelta": { "type": "boolean" },
        "afterRemoveLiquidityReturnsDelta": { "type": "boolean" }
      }
    },
    "hookProperties": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dynamicFee",
        "upgradeable",
        "requiresCustomSwapData",
        "vanillaSwap",
        "swapAccess"
      ],
      "properties": {
        "dynamicFee": { "type": "boolean" },
        "upgradeable": { "type": "boolean" },
        "requiresCustomSwapData": { "type": "boolean" },
        "vanillaSwap": { "type": "boolean" },
        "swapAccess": {
          "enum": ["none", "temporal", "allowlist", "governance", "other"]
        }
      }
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deploymentId",
        "environment",
        "chain",
        "chainId",
        "hookAddress",
        "deployerAddress",
        "poolManagerAddress",
        "transactionHash",
        "blockNumber",
        "runtimeCodeHash",
        "verifiedSourceCommit",
        "sourceVerified",
        "sourceVerificationUrl",
        "observedBlock",
        "observedAt",
        "pools",
        "uniswapEligibility",
        "uniswap"
      ],
      "properties": {
        "deploymentId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "maxLength": 160
        },
        "environment": {
          "enum": ["testnet", "mainnet"]
        },
        "chain": {
          "type": "string",
          "pattern": "^[a-z0-9]+$",
          "maxLength": 40
        },
        "chainId": {
          "type": "integer",
          "minimum": 1
        },
        "hookAddress": {
          "$ref": "#/definitions/address"
        },
        "deployerAddress": {
          "$ref": "#/definitions/address"
        },
        "poolManagerAddress": {
          "$ref": "#/definitions/address"
        },
        "transactionHash": {
          "$ref": "#/definitions/bytes32"
        },
        "blockNumber": {
          "type": "integer",
          "minimum": 1
        },
        "runtimeCodeHash": {
          "$ref": "#/definitions/bytes32"
        },
        "verifiedSourceCommit": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{40}$"
        },
        "sourceVerified": {
          "type": "boolean"
        },
        "sourceVerificationUrl": {
          "$ref": "#/definitions/httpsUrl"
        },
        "observedBlock": {
          "type": "integer",
          "minimum": 1
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        },
        "pools": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "poolId",
              "routingFormPoolReference",
              "initializationTransactionHash",
              "initializationBlockNumber",
              "liquidityTransactionHash",
              "liquidityBlockNumber",
              "liquidityEvidenceUrl",
              "observedAt"
            ],
            "properties": {
              "poolId": {
                "$ref": "#/definitions/bytes32"
              },
              "routingFormPoolReference": {
                "type": "string",
                "pattern": "^0x(?:[a-fA-F0-9]{40}|[a-fA-F0-9]{64})$"
              },
              "initializationTransactionHash": {
                "$ref": "#/definitions/bytes32"
              },
              "initializationBlockNumber": {
                "type": "integer",
                "minimum": 1
              },
              "liquidityTransactionHash": {
                "$ref": "#/definitions/bytes32"
              },
              "liquidityBlockNumber": {
                "type": "integer",
                "minimum": 1
              },
              "liquidityEvidenceUrl": {
                "$ref": "#/definitions/httpsUrl"
              },
              "observedAt": {
                "type": "string",
                "format": "date-time"
              },
              "majorTokenPair": {
                "type": "boolean",
                "default": false
              }
            }
          }
        },
        "uniswapEligibility": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "modifiesOrBypassesProtocolFee",
            "requiresRouterModificationForOrdinarySwaps",
            "knownMaliciousOrExtractiveBehavior",
            "attestedAt",
            "attestedBy"
          ],
          "properties": {
            "modifiesOrBypassesProtocolFee": { "type": "boolean" },
            "requiresRouterModificationForOrdinarySwaps": { "type": "boolean" },
            "knownMaliciousOrExtractiveBehavior": { "type": "boolean" },
            "attestedAt": { "type": "string", "format": "date-time" },
            "attestedBy": { "type": "string", "minLength": 1, "maxLength": 120 }
          }
        },
        "uniswap": {
          "type": "object",
          "additionalProperties": false,
          "required": ["hooklist", "routing"],
          "properties": {
            "hooklist": {
              "type": "object",
              "additionalProperties": false,
              "required": ["status"],
              "properties": {
                "status": {
                  "enum": ["not-submitted", "pending", "listed", "rejected"]
                },
                "issueUrl": { "$ref": "#/definitions/httpsUrl" },
                "listingUrl": { "$ref": "#/definitions/httpsUrl" }
              }
            },
            "routing": {
              "type": "object",
              "additionalProperties": false,
              "required": ["status"],
              "properties": {
                "status": {
                  "enum": [
                    "not-evaluated",
                    "automatic",
                    "review-required",
                    "submitted",
                    "allowlisted",
                    "rejected"
                  ]
                },
                "receiptUrl": { "$ref": "#/definitions/httpsUrl" }
              }
            }
          }
        }
      }
    }
  }
}
